<!--
  À fusionner dans le pom.xml du module web (packaging war).
  Ce module doit dépendre de tes modules métier (BusinessFactory, entities, io.mqtt).
-->
<project>
    <packaging>war</packaging>

    <properties>
        <kotlin.version>2.0.21</kotlin.version>
        <primefaces.version>14.0.0</primefaces.version>
    </properties>

    <dependencies>
        <!-- Serveur Jakarta EE 10 complet (Payara 6, GlassFish 7, WildFly 27+) : fournit Faces 4 + CDI 4 -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PrimeFaces, version Jakarta -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>${primefaces.version}</version>
            <classifier>jakarta</classifier>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

          <dependency>
              <groupId>org.glassfish</groupId>
              <artifactId>jakarta.faces</artifactId>
              <version>4.0.8</version>
          </dependency>
          <dependency>
              <groupId>org.jboss.weld.servlet</groupId>
              <artifactId>weld-servlet-shaded</artifactId>
              <version>5.1.3.Final</version>
          </dependency>

    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals><goal>compile</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>17</jvmTarget>
                    <!--
                      Indispensable : CDI crée des proxies pour les beans @SessionScoped / @ViewScoped,
                      donc les classes et leurs méthodes ne doivent pas être final (défaut Kotlin).
                    -->
                    <compilerPlugins>
                        <plugin>all-open</plugin>
                    </compilerPlugins>
                    <pluginOptions>
                        <option>all-open:annotation=jakarta.inject.Named</option>
                    </pluginOptions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
