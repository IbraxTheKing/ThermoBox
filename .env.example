# Copiez ce fichier en .env (ou lancez scripts/init-env.sh qui génère les secrets).
# .env ne doit JAMAIS être commité : ajoutez ".env" à .gitignore (il est déjà dans .dockerignore).

# --- Base de données ---------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=thermobox
MYSQL_USER=thermobox
MYSQL_PASSWORD=

# --- Authentification JWT (32 caractères minimum, sinon le serveur refuse de démarrer) ---
THERMOBOX_JWT_SECRET=
THERMOBOX_JWT_TTL_MINUTES=60

# --- Fuseau horaire des conteneurs (les dates des mesures en dépendent) -------
TZ=Europe/Paris

# --- Ports publiés sur la machine hôte ---------------------------------------
REST_PORT=8080
TOMCAT_PORT=8081
WILDFLY_PORT=8082
MYSQL_PORT=3306
MQTT_PORT=1883
