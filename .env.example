# Copy this file to .env (or run scripts/init-env.sh, which generates the secrets).
# .env must NEVER be committed: add ".env" to .gitignore (it is already in .dockerignore).

# --- Database ----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=thermobox
MYSQL_USER=thermobox
MYSQL_PASSWORD=
# How the server reaches the database: jpa (EclipseLink, default) or jdbc (plain SQL, without JPA)
THERMOBOX_DB_ACCESS=jpa

# --- JWT authentication (32 characters minimum, otherwise the server refuses to start) ---
THERMOBOX_JWT_SECRET=
THERMOBOX_JWT_TTL_MINUTES=60

# --- Time zone of the containers (the dates of the measurements depend on it) --
TZ=Europe/Paris

# --- Ports published on the host machine -------------------------------------
REST_PORT=8080
MYSQL_PORT=3306
MQTT_PORT=1883

# --- Updates from the interface -----------------------------------------------
# Version written into the images built here (the version tag, e.g. 26.11.0).
# "dev": the interface doesn't know its version and handles every update as a feature update.
THERMOBOX_VERSION=dev
# stable, or prerelease to also offer the nightly, beta and rc versions
THERMOBOX_UPDATE_CHANNEL=stable
# false to turn off the daily check on GitHub
THERMOBOX_UPDATE_CHECK=true
# Optional: GitHub token (read only) if the limit of 60 requests/hour gets in the way
THERMOBOX_GITHUB_TOKEN=

# --- Devices ----------------------------------------------------------------------
# simulated (simulated devices) or mqtt (real devices; docker compose --profile mqtt for the broker)
THERMOBOX_DRIVER=simulated
# MQTT broker: the compose's Mosquitto by default (ssl://host:8883 for a TLS broker)
THERMOBOX_MQTT_URL=tcp://mosquitto:1883
THERMOBOX_MQTT_USER=
THERMOBOX_MQTT_PASSWORD=
