# WildFly configuration, run once while the image is built.
#
# No datasource here: the application opens its own JDBC connection with the THERMOBOX_DB_*
# environment variables (PersistenceFactory), a JNDI datasource would not be used.

embed-server --server-config=standalone.xml --std-out=echo

# Removes the WildFly welcome page so that ROOT.war answers on "/"
if (outcome == success) of /subsystem=undertow/server=default-server/host=default-host/location=\/:read-resource
    /subsystem=undertow/server=default-server/host=default-host/location=\/:remove
end-if

# Room photo uploads: web.xml allows 11 MB per request (max-request-size), the default Undertow
# limit is 10 MB.
/subsystem=undertow/server=default-server/http-listener=default:write-attribute(name=max-post-size, value=12582912)

stop-embedded-server
