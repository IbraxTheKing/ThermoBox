<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
             https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="thermoboxPU">

        <provider>
            org.eclipse.persistence.jpa.PersistenceProvider
        </provider>

        <class>ax.ibr.thermobox.common.entities.User</class>
        <class>ax.ibr.thermobox.common.entities.Temperature</class>
        <class>ax.ibr.thermobox.common.entities.Room</class>
        <class>ax.ibr.thermobox.common.entities.Building</class>
        <class>ax.ibr.thermobox.common.entities.Floor</class>
        <class>ax.ibr.thermobox.common.entities.Device</class>
        <class>ax.ibr.thermobox.common.entities.RoomRoomAttr</class>
        <class>ax.ibr.thermobox.common.entities.Favorite</class>
        <class>ax.ibr.thermobox.common.entities.RoomImage</class>
        <class>ax.ibr.thermobox.common.entities.RoomTempAttr</class>
        <class>ax.ibr.thermobox.common.entities.Setpoint</class>
        <class>ax.ibr.thermobox.common.entities.Measurement</class>
        <class>ax.ibr.thermobox.common.entities.Access</class>
        <class>ax.ibr.thermobox.common.entities.RestrictedAccess</class>
        <class>ax.ibr.thermobox.common.entities.UserGroup</class>
        <class>ax.ibr.thermobox.common.entities.UserGroupMember</class>
        <class>ax.ibr.thermobox.common.entities.UserGroupAccess</class>

        <!-- No shared cache: every operation reads the database (the services already open one
             EntityManager per operation), so several servers on one database never see stale
             data, and millions of measurements never pile up in memory. -->
        <shared-cache-mode>NONE</shared-cache-mode>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <!-- URL, user and password come from environment variables (see PersistenceFactory). -->

            <!-- The schema belongs to the Flyway migrations (db/migration, see DatabaseMigrations). -->
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="none"/>

        </properties>

    </persistence-unit>

</persistence>