<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
             https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="thermoboxPU">

        <provider>
            org.eclipse.persistence.jpa.PersistenceProvider
        </provider>

        <class>ax.ibr.thermobox.common.entities.User</class>
        <class>ax.ibr.thermobox.common.entities.Temperature</class>
        <class>ax.ibr.thermobox.common.entities.Salle</class>
        <class>ax.ibr.thermobox.common.entities.Batiment</class>
        <class>ax.ibr.thermobox.common.entities.Etage</class>
        <class>ax.ibr.thermobox.common.entities.Boitier</class>
        <class>ax.ibr.thermobox.common.entities.SalleSalleAttr</class>
        <class>ax.ibr.thermobox.common.entities.Favori</class>
        <class>ax.ibr.thermobox.common.entities.SalleImage</class>
        <class>ax.ibr.thermobox.common.entities.SalleTempAttr</class>
        <class>ax.ibr.thermobox.common.entities.Consigne</class>
        <class>ax.ibr.thermobox.common.entities.Mesurer</class>
        <class>ax.ibr.thermobox.common.entities.Acces</class>
        <class>ax.ibr.thermobox.common.entities.AccesRestreint</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <!-- URL, user and password come from environment variables (see PersistenceFactory). -->

            <!-- The schema belongs to the Flyway migrations (db/migration, see MigrationsBase). -->
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="none"/>

        </properties>

    </persistence-unit>

</persistence>